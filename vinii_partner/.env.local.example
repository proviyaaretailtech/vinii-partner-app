# Copy to .env.local (ignored by Git) and run ./tool/run_local.sh
# The app has no sample data: it shows only what is in this Supabase project.
APP_ENV=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# One Local server that owns /api/partner/* (delivery order actions).
PARTNER_API_BASE_URL=
STOREFRONT_BASE_URL=https://vinii.app

# Never put a Supabase service-role key, database password or any other
# secret here. The launcher refuses unknown keys, and anything passed as a
# --dart-define can be read out of the installed app.
